set -Eeuo pipefail
IFS=$'\n\t'

main() {
  CNPATRONI_APP_USER="${CNPATRONI_APP_USER:-app}"
  CNPATRONI_APP_DB="${CNPATRONI_APP_DB:-app}"
  CNPATRONI_APP_PASSWORD="$(cat "${CNPATRONI_SECRETS_DIR}/app-password")"
  export CNPATRONI_APP_USER CNPATRONI_APP_DB CNPATRONI_APP_PASSWORD

  psql "$1" --no-psqlrc --set ON_ERROR_STOP=1 <<'SQL'
\getenv app_user CNPATRONI_APP_USER
\getenv app_db   CNPATRONI_APP_DB
\getenv app_pw   CNPATRONI_APP_PASSWORD
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'app_user', :'app_pw')
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_user') \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'app_db', :'app_user')
 WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_db') \gexec
SQL
}

main "$@"
